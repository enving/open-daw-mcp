{
  "name": "open-daw-mcp",
  "version": "2.0.0",
  "description": "Model Context Protocol Server für sprachgesteuerte Songerstellung mit Carla + Python + MPE Integration",
  "main": "src/server/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "start:http": "node start-http-server.js",
    "test": "node tests/mvp/test-carla-mpe-mvp.js",
    "test:pipeline": "node tests/mvp/test-llm-mpe-pipeline.js",
    "test:ionos": "node test-ionos-mcp-integration.js",
    "test:carla": "node test-carla-mpe-python.js",
    "create:mpe": "node create-mpe-scripts.js",
    "setup:vm": "bash setup-vm-config.sh",
    "start:vm": "bash start-vm-system.sh",
    "start:ardour": "bash start-ardour-vm.sh",
    "setup:cloudflare": "bash setup-cloudflare-tunnel.sh",
    "setup:openwebui": "bash install-openwebui-vm.sh",
    "copy:token": "bash copy-ionos-token.sh"
  },
  "keywords": [
    "mcp",
    "carla",
    "mpe",
    "audio",
    "llm",
    "ionos",
    "music",
    "synthesis",
    "openwebui"
  ],
  "author": "Open DAW MCP Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "ws": "^8.14.2",
    "tone": "^14.7.77",
    "osc": "^2.4.1",
    "midi": "^0.12.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/open-daw-mcp.git"
  },
