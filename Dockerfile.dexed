FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    cmake \
    git \
    libasound2-dev \
    libjack-jackd2-dev \
    libsndfile1-dev \
    libportaudio2 \
    libportaudiocpp0 \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install numpy scipy flask requests flask-cors

# Copy Dexed source
COPY dexed /app/dexed

# Copy Dexed server
COPY dexed_server.py /app/dexed_server.py

# Build Dexed (optional - kann fehlschlagen)
WORKDIR /app/dexed
RUN git submodule update --init --recursive || true
RUN mkdir -p build && cd build && cmake .. && make -j$(nproc) || echo "Dexed build failed, using simulation"

WORKDIR /app
EXPOSE 8081

CMD ["python3", "dexed_server.py"] 