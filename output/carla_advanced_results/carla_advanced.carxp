
# Erweitertes Carla Project mit FluidSynth
# MIDI Input -> FluidSynth LV2 -> Audio Output

[Project]
Name=Carla Advanced MIDI Test
Version=2.0
Engine=JACK

[MIDI Input]
Port=1
Channel=1
Enabled=true
Name=MIDI Input

[LV2 Plugin]
URI=http://lv2plug.in/plugins/a-fluidsynth
Name=FluidSynth
Enabled=true
Port=2
Parameters:
  SoundFont=/usr/share/sounds/sf2/FluidR3_GM.sf2
  Bank=0
  Program=0

[Audio Output]
Port=1
Enabled=true
Name=Audio Output

[Connections]
MIDI Input:out -> FluidSynth:in
FluidSynth:out -> Audio Output:in

