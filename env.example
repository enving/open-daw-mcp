# IONOS Sprachmodell API Konfiguration
IONOS_API_URL=https://api.ionos.com/v1/ai/chat/completions
IONOS_API_TOKEN=your_ionos_api_token_here

# MCP Server Konfiguration
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost

# Ardour OSC Konfiguration
ARDOUR_OSC_HOST=localhost
ARDOUR_OSC_PORT=3819
ARDOUR_OSC_SEND_PORT=3818

# Audio Konfiguration
AUDIO_SAMPLE_RATE=44100
AUDIO_BIT_DEPTH=16
AUDIO_CHANNELS=2

# Synthesizer Konfiguration
SYNTH_DEFAULT_BPM=120
SYNTH_DEFAULT_KEY=C
SYNTH_DEFAULT_SCALE=major

# Datei-Pfade
AUDIO_OUTPUT_DIR=./output
TEMP_DIR=./temp
ARDOUR_SESSION_DIR=./sessions 