{
  "tools": [
    {
      "name": "generate_melody",
      "description": "Generiert eine Melodie basierend auf Noten-Frequenzen",
      "parameters": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Array von Frequenzen in Hz (z.B. [261.63, 329.63, 392.00, 523.25] für C-E-G-C)"
          },
          "duration": {
            "type": "number",
            "description": "Dauer der Melodie in Sekunden",
            "default": 5.0
          },
          "style": {
            "type": "string",
            "enum": ["classical", "electronic", "jazz", "pop"],
            "description": "Musikstil",
            "default": "classical"
          }
        },
        "required": ["notes"]
      },
      "url": "http://87.106.81.49:3002/generate-melody",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "name": "generate_song",
      "description": "Generiert einen kompletten Song basierend auf einer Beschreibung",
      "parameters": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Beschreibung des gewünschten Songs (z.B. 'Ein elektronischer Song mit Bass und Drums')"
          },
          "duration": {
            "type": "number",
            "description": "Dauer des Songs in Sekunden",
            "default": 30.0
          },
          "style": {
            "type": "string",
            "enum": ["electronic", "classical", "jazz", "pop", "rock"],
            "description": "Musikstil",
            "default": "electronic"
          }
        },
        "required": ["description"]
      },
      "url": "http://87.106.81.49:3002/generate-song",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "name": "list_audio_files",
      "description": "Listet alle verfügbaren Audio-Dateien auf",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "url": "http://87.106.81.49:3002/audio-files",
      "method": "GET"
    }
  ],
  "audio_handling": {
    "audio_url_base": "http://87.106.81.49:3002/audio/",
    "supported_formats": ["wav", "mp3", "mid"],
    "embed_audio": true,
    "auto_play": false
  }
} 