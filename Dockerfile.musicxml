# MusicXML Parser API - Konvertiert MusicXML zu JSON/MIDI
FROM python:3.12-slim

# Setze Umgebungsvariablen
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

# Installiere System Dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Setze Arbeitsverzeichnis
WORKDIR /app

# Kopiere Requirements und installiere Python Dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Erstelle Output Verzeichnisse
RUN mkdir -p /app/output/audio /app/output/musicxml /app/output/midi /app/projects

# Kopiere Application Code
COPY src/ /app/src/
COPY web/ /app/web/
COPY output/ /app/output/

# Expose Port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Default command
CMD ["python3", "src/server/reaper_api.py"] 